<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only Android 9 and older need this: there MediaStore still writes through shared
         storage. From Android 10 an app writing its own new image needs no permission, and
         SaveImagePermission grants without asking — so the declaration stops at 28 to match. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="androidx.car.app.MEDIA_TEMPLATES" />
    <!-- Login sync: scanning the QR shown by SimpMusic Desktop. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Login sync reaches the computer by its LAN address. Only enforced for apps targeting
         Android 17 (API 37) and up, where it is a runtime permission; LoginSync.android.kt asks
         for it then. Declared now so a targetSdk bump cannot make the connection silently time out. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Song recognition in Search: a few seconds of microphone audio, fingerprinted for Shazam. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <!-- Android TV devices commonly have no touchscreen. Keep phone compatibility. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- Requesting CAMERA implies a required camera, which would hide the app from TVs and cars. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Likewise RECORD_AUDIO implies a required microphone. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />
    <uses-feature
        android:name="android.software.car.templates_host.media"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>
    <queries>
        <package android:name="com.maxrave.simpmusic" />
    </queries>
    <queries>
        <intent>
            <action android:name="androidx.media3.session.MediaSessionService" />
        </intent>
    </queries>

    <application
        android:name=".SimpMusicApplication"
        android:allowBackup="false"
        android:appCategory="audio"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="SimpMusic TV"
        android:localeConfig="@xml/locale_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpMusic"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true"
        tools:replace="android:name,android:allowBackup"
        tools:targetApi="tiramisu">

        <activity android:name=".tv.TvActivity" android:exported="true"
            android:screenOrientation="landscape" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="cat.ereza.customactivityoncrash.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Existing service PendingIntents and crash restart resolve to the TV shell. -->
        <activity-alias android:name=".MainActivity" android:targetActivity=".tv.TvActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/monochrome" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <service
            android:name="com.maxrave.media3.service.SimpleMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
        <service
            android:name="com.maxrave.media3.service.download.MusicDownloadService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="8" />

        <service
            android:name="com.maxrave.media3.carapp.SimpMusicCarAppService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <action android:name="androidx.car.app.media.action.SHOW_MEDIA_PLAYBACK" />
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
        </service>


        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- Quick Settings tile: a shortcut to the song recognition sheet (simpmusic://recognize). -->
        <service
            android:name=".service.RecognitionTileService"
            android:exported="true"
            android:icon="@drawable/rounded_graphic_eq_24"
            android:label="@string/qs_tile_recognize_song"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <receiver android:name=".ui.widget.TurntableWidgetReceiver"
            android:label="@string/widget_turntable_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/turntable_widget_info" />
        </receiver>

        <receiver android:name=".ui.widget.PlaylistsWidgetReceiver"
            android:label="@string/widget_playlists_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/playlists_widget_info" />
        </receiver>

        <receiver android:name=".ui.widget.ListeningInsightsWidgetReceiver"
            android:label="@string/widget_insights_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/insights_widget_info" />
        </receiver>
    </application>

</manifest>
